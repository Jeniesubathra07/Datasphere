# Leave empty to use the Vite dev-server proxy (default target: http://127.0.0.1:8080).
# Set explicitly when the API runs on a different host/port.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Optional: override the Vite proxy target when VITE_API_BASE_URL is empty.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
